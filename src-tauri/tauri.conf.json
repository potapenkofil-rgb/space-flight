{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karman",
  "version": "0.0.0",
  "identifier": "app.karman.spaceflight",
  "build": {
    "beforeDevCommand": "pnpm --filter @karman/app run dev -- --port 5183 --strictPort",
    "beforeBuildCommand": "pnpm --filter @karman/app run build",
    "devUrl": "http://localhost:5183",
    "frontendDist": "../packages/app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Karman",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
